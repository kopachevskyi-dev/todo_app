{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/install-hooks.mjs",
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env src/api/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build && esbuild src/api/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:e2e": "pnpm build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
