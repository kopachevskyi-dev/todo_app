# Production server (0 asks the OS for a free port).
PORT=3000
# Host development defaults to loopback. The runtime image sets HOST=0.0.0.0;
# keep that value when overriding its environment so Docker can reach it.
HOST=127.0.0.1
DATABASE_PATH=./data/todo.db
# Never enable outside isolated tests.
ENABLE_TEST_CLOCK=false
# Vite's /api proxy target in development.
API_PORT=3000
