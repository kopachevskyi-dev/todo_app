# TEMPORARY location: change DATA_DIR to your preferred permanent folder.
# Use an absolute path, or ~/...; Docker Compose expands the leading ~.
DATA_DIR=~/Desktop/todo-app-data
APP_PORT=3000
# Empty uses the host timezone through /etc/localtime; set an IANA name to override.
TZ=
# The db/ and backups/ subfolders both move with DATA_DIR.
